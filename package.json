{
  "name": "@pascal-app/plugin-landscape",
  "version": "0.1.0",
  "description": "Landscape design plugin for the Pascal editor.",
  "homepage": "https://editor.pascal.app/docs/developers/plugins",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "scripts/dev.ts",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "dev": "bun scripts/dev.ts",
    "dev:link": "bun scripts/dev.ts --link-only",
    "dev:unlink": "bun scripts/dev.ts --unlink"
  },
  "peerDependencies": {
    "@pascal-app/core": "^1.0.1",
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@pascal-app/core": "1.0.1",
    "@types/bun": "^1.3.5",
    "@types/node": "^22.19.12",
    "@types/react": "^19.2.2",
    "react": "^19",
    "three": "^0.186.0",
    "typescript": "6.0.3"
  },
  "keywords": [
    "pascal",
    "landscape",
    "plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudhir9297/landscape-pascal-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/sudhir9297/landscape-pascal-plugin/issues"
  }
}
