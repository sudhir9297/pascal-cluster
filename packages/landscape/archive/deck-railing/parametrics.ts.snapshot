import type { ParametricDescriptor } from '@pascal-app/core'
import { DECK_MATERIAL_COLORS } from '../domain/settings'
import type { DeckNode } from '../domain/schema'

export const deckParametrics: ParametricDescriptor<DeckNode> = {
  derive: (current, patch) => ({
    ...(patch.material && patch.boardColor === undefined &&
      current.boardColor === DECK_MATERIAL_COLORS[current.material]
      ? { boardColor: DECK_MATERIAL_COLORS[patch.material] } : {}),
    ...(patch.deckType && patch.deckType !== current.deckType ? {
      thickness: patch.deckType === 'raised' ? Math.max(current.thickness, 1.2) : Math.min(current.thickness, 0.45),
      supportPosts: patch.deckType === 'raised',
    } : {}),
    ...(patch.railingEdgeMode === 'selected' && current.railingEdges.length === 0
      ? { railingEdges: Array.from({ length: current.shape === 'rectangle' ? 4 : current.outline.length },
        (_, index) => index) } : {}),
  }),
  groups: [
    { label: 'Deck size and type', fields: [
      { key: 'width', label: 'Width', kind: 'number', unit: 'm', min: 0.2, max: 30, step: 0.1 },
      { key: 'depth', label: 'Depth', kind: 'number', unit: 'm', min: 0.2, max: 30, step: 0.1 },
      { key: 'deckType', label: 'Type', kind: 'enum', options: ['platform', 'raised'] },
      { key: 'thickness', label: 'Deck height', kind: 'number', unit: 'm', min: 0.03, max: 2, step: 0.01 },
    ] },
    { label: 'Deck boards', fields: [
      { key: 'material', label: 'Material', kind: 'enum',
        options: ['pressure-treated', 'cedar', 'hardwood', 'composite', 'pvc'] },
      { key: 'boardDirection', label: 'Direction', kind: 'enum',
        options: ['lengthwise', 'crosswise', 'diagonal'] },
      { key: 'boardWidth', label: 'Board width', kind: 'number', unit: 'm', min: 0.09, max: 0.25, step: 0.005 },
      { key: 'boardGap', label: 'Board gap', kind: 'number', unit: 'm', min: 0.003, max: 0.025, step: 0.001 },
      { key: 'boardThickness', label: 'Board thickness', kind: 'number', unit: 'm', min: 0.018, max: 0.06, step: 0.002 },
      { key: 'boardColor', label: 'Board color', kind: 'color' },
    ] },
    { label: 'Perimeter finish', fields: [
      { key: 'borderStyle', label: 'Picture frame', kind: 'enum', options: ['none', 'single', 'double'] },
      { key: 'borderColor', label: 'Border color', kind: 'color', visibleIf: (node) => node.borderStyle !== 'none' },
      { key: 'fascia', label: 'Fascia', kind: 'boolean' },
      { key: 'fasciaColor', label: 'Fascia color', kind: 'color', visibleIf: (node) => node.fascia },
      { key: 'skirtStyle', label: 'Skirting', kind: 'enum', options: ['none', 'solid', 'slatted'] },
      { key: 'skirtColor', label: 'Skirting color', kind: 'color', visibleIf: (node) => node.skirtStyle !== 'none' },
    ] },
    { label: 'Frame and posts', fields: [
      { key: 'frameDepth', label: 'Frame depth', kind: 'number', unit: 'm', min: 0.08, max: 0.4, step: 0.01 },
      { key: 'frameColor', label: 'Frame color', kind: 'color' },
      { key: 'supportPosts', label: 'Support posts', kind: 'boolean', visibleIf: (node) => node.deckType === 'raised' },
      { key: 'supportSpacing', label: 'Support spacing', kind: 'number', unit: 'm', min: 0.8, max: 4, step: 0.1,
        visibleIf: (node) => node.deckType === 'raised' && node.supportPosts },
      { key: 'postSize', label: 'Post width', kind: 'number', unit: 'm', min: 0.07, max: 0.25, step: 0.01,
        visibleIf: (node) => node.deckType === 'raised' && node.supportPosts },
      { key: 'postColor', label: 'Post color', kind: 'color',
        visibleIf: (node) => node.deckType === 'raised' && node.supportPosts },
    ] },
    { label: 'Railing', fields: [
      { key: 'railingStyle', label: 'Style', kind: 'enum', options: ['none', 'wood', 'metal', 'cable', 'glass'] },
      { key: 'railingHeight', label: 'Height', kind: 'number', unit: 'm', min: 0.75, max: 1.3, step: 0.05,
        visibleIf: (node) => node.railingStyle !== 'none' },
      { key: 'railingPostSpacing', label: 'Post spacing', kind: 'number', unit: 'm', min: 0.6, max: 2.5, step: 0.1,
        visibleIf: (node) => node.railingStyle !== 'none' },
      { key: 'railingColor', label: 'Color', kind: 'color', visibleIf: (node) => node.railingStyle !== 'none' },
      { key: 'railingEdgeMode', label: 'Edges', kind: 'enum', options: ['all', 'selected'],
        visibleIf: (node) => node.railingStyle !== 'none' },
    ] },
  ],
}
