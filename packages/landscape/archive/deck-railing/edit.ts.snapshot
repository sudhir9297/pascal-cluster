import type { Point } from '../../../ground-areas/domain/schema'
import { surfaceEditPatch, surfaceLevelOutline } from '../../shared/outline'
import type { DeckNode } from './schema'

function distanceToEdge(point: Point, a: Point, b: Point) {
  const dx = b[0] - a[0], dz = b[1] - a[1]
  const lengthSquared = dx * dx + dz * dz
  const t = lengthSquared ? Math.max(0, Math.min(1,
    ((point[0] - a[0]) * dx + (point[1] - a[1]) * dz) / lengthSquared)) : 0
  return Math.hypot(point[0] - a[0] - t * dx, point[1] - a[1] - t * dz)
}

export function deckEditPatch(node: DeckNode, points: Point[]) {
  const patch = surfaceEditPatch(node, points, 'deck')
  if (!patch || node.railingEdgeMode !== 'selected') return patch
  const old = surfaceLevelOutline(node)
  if (old.length === points.length) return patch
  const selected = new Set(node.railingEdges)
  const railingEdges = points.flatMap((a, index) => {
    const b = points[(index + 1) % points.length]!
    const midpoint: Point = [(a[0] + b[0]) / 2, (a[1] + b[1]) / 2]
    let nearest = 0, distance = Infinity
    old.forEach((start, oldIndex) => {
      const value = distanceToEdge(midpoint, start, old[(oldIndex + 1) % old.length]!)
      if (value < distance) { distance = value; nearest = oldIndex }
    })
    return selected.has(nearest) ? [index] : []
  })
  return { ...patch, railingEdges }
}
